#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.lcnt/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
lcntCore-cbs.pcs
cbs: Capability Bundle Specification  -- Based on a cba-sysd.cs seed, of type induct (no units)
i:  Induct      --- /Non-Service Component/ --- The LCNT core: LaTeX, HeVeA, fonts and the PDF viewer
n:  No Data    -- Materialization is purely based on Realm-BPO
p:  Platform    -- Materialization is based on Platform-BPO (Site-BPO is not used)

The bundle: lcntCore-sbom.pcs (the existing lcaLaTexBinsPrep.sh steps, evince, and the nested
rawBisos-fonts-sbom.pcs) and lcntCore-assemble.cs (toolchainCheck, which fails loudly on anything
missing: neither the sbom steps nor the CBM walker report a failed install as one).
The LCNT bases (/de/sys/lcnt, /lcnt) are lcntBases; audio and video are a later lcntMultiMedia.
#+end_org """

from bisos.capability import cba_sysd_seed
from bisos.capability import cba_seed

cba_seed.setup(
    seedType="induct",  # not systemd: cbs_materialize runs the sbom and the assemble only
    loader=None,
    sbom="lcntCore-sbom.pcs",
    assemble="lcntCore-assemble.cs",
    materialize=None,
)

cba_sysd_seed.plantWithWhich("cba-sysd.cs")
