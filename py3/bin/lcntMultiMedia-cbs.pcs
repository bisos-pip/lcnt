#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.lcnt/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
lcntMultiMedia-cbs.pcs
cbs: Capability Bundle Specification  -- Based on a cba-sysd.cs seed, of type induct (no units)
i:  Induct      --- /Non-Service Component/ --- LCNT multimedia: reveal.js, display and, by environment, media tools
n:  No Data    -- Materialization is purely based on Realm-BPO
p:  Platform    -- Materialization is based on Platform-BPO (Site-BPO is not used)

The bundle: lcntMultiMedia-sbom.pcs (apt packages of the detected environment, Container, VM or Box, and
reveal.js through lcaJsRevealBinsPrep.sh) and lcntMultiMedia-assemble.cs (toolchainCheck: lcntCore is
checked, never installed; then every program of the environment, failing loudly).
Materialize lcntCore first. Container: no audio, no video recording. Deferred: aeneas, whisper, subed.
#+end_org """

from bisos.capability import cba_sysd_seed
from bisos.capability import cba_seed

cba_seed.setup(
    seedType="induct",  # not systemd: cbs_materialize runs the sbom and the assemble only
    loader=None,
    sbom="lcntMultiMedia-sbom.pcs",
    assemble="lcntMultiMedia-assemble.cs",
    materialize=None,
)

cba_sysd_seed.plantWithWhich("cba-sysd.cs")
