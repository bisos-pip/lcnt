#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.lcnt/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
lcntMultiMedia-sbom.pcs
The software bill of materials of lcntMultiMedia: what LCNT needs beyond the core to show, record and
produce media, conditioned on the environment (Container, VM or Box: lcntMultiMediaInfo.py).
lcntCore is checked by lcntMultiMedia-assemble.cs, it is not nested here (decided 2026-11-11).
Deferred in every environment: aeneas, whisper, subed, wdiff.
#+end_org """

from bisos import b
from bisos.b import cs
from bisos.b import b_io

from bisos.sbom import pkgsSeed  # pkgsSeed.plantWithWhich("seedSbom.cs")

from bisos.lcnt import lcntMultiMediaInfo as info

ap = pkgsSeed.aptPkg

lcntMmEnv = info.environmentDetect()


def lcntMmAptUpdate() -> None:
    """The Debian index goes stale (lcntCore found a 404 on a debian-security package)."""
    if b.subProc.WOpW(invedBy=None, log=1).bash(
            """sudo apt-get update""",
    ).isProblematic():
        print("lcntMultiMedia-sbom: FAILED: apt-get update")


def lcntMmRevealJs() -> None:
    """reveal.js and reveal.js-plugins, global npm packages: the old lcaJsRevealBinsPrep.sh does it."""
    if b.subProc.WOpW(invedBy=None, log=1).bash(
            f"""{info.revealScript} -h -v -n showRun -i fullUpdate""",
    ).isProblematic():
        print(f"lcntMultiMedia-sbom: FAILED: {info.revealScript} -i fullUpdate")


def lcntMmKernelHeaders() -> None:
    """Box only: v4l2loopback-dkms builds a kernel module and needs the headers of the running kernel."""
    if b.subProc.WOpW(invedBy=None, log=1).bash(
            """sudo DEBIAN_FRONTEND=noninteractive apt-get -y install linux-headers-$(uname -r)""",
    ).isProblematic():
        print("lcntMultiMedia-sbom: FAILED: linux-headers-$(uname -r)")


aptPkgsList = [ap("lcntMmAptUpdate", func=lcntMmAptUpdate)]
if lcntMmEnv == info.envBox:
    aptPkgsList.append(ap("lcntMmKernelHeaders", func=lcntMmKernelHeaders))   # before v4l2loopback-dkms
aptPkgsList += [ap(each) for each in info.aptNamesFor(lcntMmEnv)]
aptPkgsList.append(ap("lcntMmRevealJs", func=lcntMmRevealJs))

pkgsSeed.setup(
    aptPkgsList=aptPkgsList,
)


####+BEGIN: b:py3:cs:cmnd/classHead :cmndName "readme" :extent "verify" :comment "Describe" :parsMand "" :parsOpt "" :argsMin 0 :argsMax 0 :pyInv ""
""" #+begin_org
*  _[[elisp:(blee:menu-sel:outline:popupMenu)][±]]_ _[[elisp:(blee:menu-sel:navigation:popupMenu)][Ξ]]_ [[elisp:(outline-show-branches+toggle)][|=]] [[elisp:(bx:orgm:indirectBufOther)][|>]] *[[elisp:(blee:ppmm:org-mode-toggle)][|N]]*  CmndSvc-   [[elisp:(outline-show-subtree+toggle)][||]] <<readme>>  *Describe*  =verify= ro=cli   [[elisp:(org-cycle)][| ]]
#+end_org """
class readme(cs.Cmnd):
    cmndParamsMandatory = [ ]
    cmndParamsOptional = [ ]
    cmndArgsLen = {'Min': 0, 'Max': 0,}

    @cs.track(fnLoc=True, fnEntry=True, fnExit=True)
    def cmnd(self,
             rtInv: cs.RtInvoker,
             cmndOutcome: b.op.Outcome,
    ) -> b.op.Outcome:
        """Describe"""
        failed = b_io.eh.badOutcome
        callParamsDict = {}
        if self.invocationValidate(rtInv, cmndOutcome, callParamsDict, None).isProblematic():
            return failed(cmndOutcome)
####+END:
        descriptionStr = f"""\
lcntMultiMedia, for this environment: {lcntMmEnv} ({info.environmentVirtName()}).
Override: {info.environmentOverrideName}=Container|VM|Box. Uses sudo.
|-----------+--------------------------------------------------------------------------------|
| Container | mpv, gimp, imagemagick, pdftk-java (display-only, PDF and image tools)         |
| VM        | Container + sox, ffmpeg, audacity, pavucontrol, vlc, lame, flac, vorbis-tools, |
|           | mp3info, gifsicle, scrot, impressive (audio record, play, edit; no video rec.) |
| Box       | VM + obs-studio, v4l2loopback-dkms (+ linux headers), kdenlive (video)         |
|-----------+--------------------------------------------------------------------------------|
Every environment also gets reveal.js and reveal.js-plugins ({info.revealScript}).
Deferred everywhere: aeneas, whisper, subed, wdiff. lcntCore is checked, not installed, here.
Verification is lcntMultiMedia-assemble.cs -i toolchainCheck: this sbom reports but does not stop on a
failed step, and neither pypiProc nor the CBM walker report a failed install as one.\
"""
        print(descriptionStr)

        return cmndOutcome.set(
            opError=b.op.OpError.Success,
            opResults=None,
        )


def examples_csu() -> b.op.Outcome:
    """Common Usage Examples for this Command-Service Unit"""

    cmnd = cs.examples.cmndEnter
    literal = cs.examples.execInsert

    cmndOutcome = b.op.Outcome()

    cs.examples.menuChapter('*Description*')
    cmnd('readme', comment=" # An overview short description, for this environment")

    cs.examples.menuChapter('*Plan (read-only)*')
    literal("lcntMultiMedia-sbom.pcs -i aptPkgs_list")
    literal("LCNT_MM_ENV=VM lcntMultiMedia-sbom.pcs -i aptPkgs_list")
    literal("LCNT_MM_ENV=Box lcntMultiMedia-sbom.pcs -i aptPkgs_list")

    cs.examples.menuChapter('*Update (uses sudo)*')
    literal("lcntMultiMedia-sbom.pcs -i sbom_fullUpdate")

    cs.examples.menuChapter('*End-Of Examples*')
    return cmndOutcome
